# Server-side only. Never ship these to the app. See docs/environment.md.
ENVIRONMENT=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Only for projects on the legacy shared JWT secret; leave empty when using JWT signing keys.
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8081

# AI providers. Leave empty until you have them: features report "awaiting credentials".
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
HEYGEN_API_KEY=

# Optional model settings (see docs/environment.md for what each does).
# LLM_MODEL=claude-opus-5-5
# LLM_VISION_MODEL=claude-sonnet-5-5
# EMBEDDING_MODEL=voyage-4
# OCR_MAX_PAGES=300
