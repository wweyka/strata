# Public values only: everything prefixed EXPO_PUBLIC_ is embedded in the app bundle.
# Copy to apps/app/.env.local and fill in. See docs/environment.md.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8000
# Comma-separated OAuth providers enabled in Supabase Auth (google, apple, github). Leave empty to hide the buttons.
EXPO_PUBLIC_AUTH_PROVIDERS=
